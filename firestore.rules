rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userProfilePath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function hasRole(role) {
      return signedIn()
        && exists(userProfilePath(request.auth.uid))
        && get(userProfilePath(request.auth.uid)).data.userId == request.auth.uid
        && get(userProfilePath(request.auth.uid)).data.role == role;
    }

    function farmer() {
      return hasRole('FARMER');
    }

    function supplier() {
      return hasRole('SUPPLIER');
    }

    function listingPath(listingId) {
      return /databases/$(database)/documents/listings/$(listingId);
    }

    function ownsListing(listingId) {
      return farmer()
        && exists(listingPath(listingId))
        && get(listingPath(listingId)).data.farmerId == request.auth.uid
        && get(listingPath(listingId)).data.get('isDraft', false) == false;
    }

    function publishedListing(data) {
      return data.get('isDraft', false) == false;
    }

    // Compatible with SelectedLocation's address + bounded coordinate suffix.
    function coordinateLocation(value) {
      return value is string && value.size() <= 2000
        && value.matches('(?s).*\\[-?([0-8]?[0-9](\\.[0-9]+)?|90(\\.0+)?),\\s*-?(([0-9]?[0-9]|1[0-7][0-9])(\\.[0-9]+)?|180(\\.0+)?)\\]$');
    }
    function availableStock(data) {
      let savedStock = data.get('availableQuantity', null);
      return savedStock is number
        ? savedStock
        : data.quantity - data.get('soldQuantity', 0);
    }

    // True if the listing is an expected (future-harvest) listing.
    function isExpectedHarvest(data) {
      return data.get('harvestStatus', 'READY') == 'EXPECTED';
    }

    // Estimated quantity for pre-harvest listings. Falls back to quantity if not set.
    function estimatedQty(data) {
      let est = data.get('estimatedQuantity', null);
      return est is number && est > 0 ? est : data.quantity;
    }

    match /users/{userId} {
      allow get, list: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.userId == userId
        && request.resource.data.role in ['FARMER', 'SUPPLIER']
        && request.resource.data.get('points', 0) == 0;
      allow update: if signedIn()
        && resource.data.userId == userId
        && request.resource.data.userId == userId
        && request.resource.data.role == resource.data.role
        && (
          // User updating their own profile (cannot change points directly)
          (request.auth.uid == userId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'displayName', 'email', 'phone', 'profileImageUrl', 'location'
            ]))
        );
      allow delete: if false;
    }

    match /listings/{listingId} {
      allow get, list: if signedIn() && (
        (farmer() && resource.data.farmerId == request.auth.uid)
        || (supplier() && publishedListing(resource.data) && resource.data.status == 'OPEN')
      );

      allow create: if farmer()
        && request.resource.data.listingId == listingId
        && request.resource.data.farmerId == request.auth.uid
        && request.resource.data.status == 'OPEN'
        && request.resource.data.get('isDraft', false) == false
        && request.resource.data.biddingEnabled is bool
        && coordinateLocation(request.resource.data.get('location', ''))
        // Expected (future-harvest) listings start with zero actual stock — allow them when
        // estimatedQuantity is positive and availableQuantity is zero. All other listings need real available stock.
        && (isExpectedHarvest(request.resource.data)
          ? (estimatedQty(request.resource.data) > 0 && request.resource.data.get('availableQuantity', 0) == 0)
          : availableStock(request.resource.data) > 0);

      allow update: if farmer()
        && resource.data.farmerId == request.auth.uid
        && request.resource.data.farmerId == request.auth.uid
        && request.resource.data.listingId == listingId
        && request.resource.data.get('isDraft', false) == false
        && (request.resource.data.get('biddingEnabled', false) == false
          || (request.resource.data.status == 'OPEN'
            && (isExpectedHarvest(request.resource.data)
              ? estimatedQty(request.resource.data) > 0
              : availableStock(request.resource.data) > 0)))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'cropName', 'description', 'quantity', 'quantityUnit', 'reservePrice', 'imageUrls',
          'location', 'status', 'biddingEnabled', 'category', 'expectedHarvestAt',
          'qualityGrade', 'availableQuantity', 'soldQuantity', 'expiresAt',
          // Harvest lifecycle fields — needed for mark-ready / mark-failed / estimate updates.
          'harvestStatus', 'estimatedQuantity', 'harvestFailureReason', 'harvestUpdatedAt'
        ])
        // Harvest status transition guards: only valid transitions allowed.
        && (
          // If harvestStatus unchanged, allow other field updates within same status (unless FAILED)
          (request.resource.data.get('harvestStatus', 'READY') == resource.data.get('harvestStatus', 'READY')
            && resource.data.get('harvestStatus', 'READY') != 'FAILED')
          // EXPECTED -> EXPECTED: updating estimate or expectedHarvestAt (status unchanged)
          || (resource.data.get('harvestStatus', 'READY') == 'EXPECTED'
            && request.resource.data.get('harvestStatus', 'READY') == 'EXPECTED')
          // EXPECTED -> READY: marking harvest ready with actual quantity > 0
          || (resource.data.get('harvestStatus', 'READY') == 'EXPECTED'
            && request.resource.data.get('harvestStatus', 'READY') == 'READY'
            && availableStock(request.resource.data) > 0)
          // EXPECTED -> FAILED: marking harvest failed
          || (resource.data.get('harvestStatus', 'READY') == 'EXPECTED'
            && request.resource.data.get('harvestStatus', 'READY') == 'FAILED')
        );

      allow delete: if farmer() && resource.data.farmerId == request.auth.uid;
    }

    match /bids/{bidId} {
      allow get, list: if signedIn() && (
        (supplier() && resource.data.supplierId == request.auth.uid)
        || ownsListing(resource.data.listingId)
      );

      allow create: if supplier()
        && request.resource.data.supplierId == request.auth.uid
        && request.resource.data.status == 'PENDING'
        && request.resource.data.bidId == bidId
        && exists(listingPath(request.resource.data.listingId))
        && get(listingPath(request.resource.data.listingId)).data.status == 'OPEN'
        && get(listingPath(request.resource.data.listingId)).data.biddingEnabled == true
        && publishedListing(get(listingPath(request.resource.data.listingId)).data)
        && coordinateLocation(get(listingPath(request.resource.data.listingId)).data.get('location', ''))
        && coordinateLocation(request.resource.data.get('deliveryLocation', ''))
        && availableStock(get(listingPath(request.resource.data.listingId)).data) > 0;

      allow update: if signedIn()
        && resource.data.status == 'PENDING'
        && request.resource.data.bidId == resource.data.bidId
        && request.resource.data.listingId == resource.data.listingId
        && request.resource.data.supplierId == resource.data.supplierId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && (
          (farmer()
            && ownsListing(resource.data.listingId)
            && request.resource.data.status == 'REJECTED')
          || (supplier()
            && resource.data.supplierId == request.auth.uid
            && request.resource.data.status == 'WITHDRAWN')
          || (farmer()
            && ownsListing(resource.data.listingId)
            && request.resource.data.status == 'ACCEPTED'
            && existsAfter(/databases/$(database)/documents/orders/$(bidId))
            && getAfter(/databases/$(database)/documents/orders/$(bidId)).data.bidId == bidId
            && getAfter(/databases/$(database)/documents/orders/$(bidId)).data.listingId == resource.data.listingId)
        );

      allow delete: if false;
    }

    match /order_requests/{requestId} {
      allow get, list: if signedIn() && (
        (supplier() && resource.data.supplierId == request.auth.uid)
        || (farmer() && resource.data.farmerId == request.auth.uid)
      );

      allow create: if supplier()
        && request.resource.data.requestId == requestId
        && request.resource.data.supplierId == request.auth.uid
        && request.resource.data.status == 'PENDING'
        && request.resource.data.requestedQuantity > 0
        && exists(listingPath(request.resource.data.listingId))
        && get(listingPath(request.resource.data.listingId)).data.status == 'OPEN'
        && get(listingPath(request.resource.data.listingId)).data.biddingEnabled == false
        && publishedListing(get(listingPath(request.resource.data.listingId)).data)
        && coordinateLocation(get(listingPath(request.resource.data.listingId)).data.get('location', ''))
        && coordinateLocation(request.resource.data.get('deliveryLocation', ''))
        && request.resource.data.farmerId
          == get(listingPath(request.resource.data.listingId)).data.farmerId
        && request.resource.data.listedPrice
          == get(listingPath(request.resource.data.listingId)).data.reservePrice
        // Pre-harvest: quantity must not exceed the farmer's stated estimate.
        // Ready (normal): listing must be READY and quantity must not exceed actual available stock.
        && (isExpectedHarvest(get(listingPath(request.resource.data.listingId)).data)
          ? (request.resource.data.get('isPreHarvest', false) == true
            && request.resource.data.requestedQuantity
              <= estimatedQty(get(listingPath(request.resource.data.listingId)).data))
          : (get(listingPath(request.resource.data.listingId)).data.get('harvestStatus', 'READY') == 'READY'
            && request.resource.data.requestedQuantity
              <= availableStock(get(listingPath(request.resource.data.listingId)).data)));

      allow update: if signedIn()
        && resource.data.status == 'PENDING'
        && request.resource.data.requestId == resource.data.requestId
        && request.resource.data.listingId == resource.data.listingId
        && request.resource.data.farmerId == resource.data.farmerId
        && request.resource.data.supplierId == resource.data.supplierId
        && request.resource.data.requestedQuantity == resource.data.requestedQuantity
        && request.resource.data.listedPrice == resource.data.listedPrice
        && request.resource.data.cropName == resource.data.cropName
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && (
          (farmer()
            && ownsListing(resource.data.listingId)
            && request.resource.data.status == 'REJECTED')
          || (supplier()
            && resource.data.supplierId == request.auth.uid
            && request.resource.data.status == 'CANCELLED')
          // Farmer cancels a pre-harvest request atomically when marking the harvest failed.
          || (farmer()
            && resource.data.farmerId == request.auth.uid
            && resource.data.get('isPreHarvest', false) == true
            && request.resource.data.status == 'CANCELLED'
            && exists(listingPath(resource.data.listingId))
            && get(listingPath(resource.data.listingId)).data.get('harvestStatus', 'READY') == 'FAILED')
          || (farmer()
            && ownsListing(resource.data.listingId)
            && request.resource.data.status == 'ACCEPTED'
            && existsAfter(/databases/$(database)/documents/orders/$(requestId))
            && getAfter(/databases/$(database)/documents/orders/$(requestId)).data.orderId == requestId
            && getAfter(/databases/$(database)/documents/orders/$(requestId)).data.bidId == ''
            && getAfter(/databases/$(database)/documents/orders/$(requestId)).data.listingId == resource.data.listingId
            && getAfter(/databases/$(database)/documents/orders/$(requestId)).data.supplierId == resource.data.supplierId
            && getAfter(/databases/$(database)/documents/orders/$(requestId)).data.farmerId == resource.data.farmerId
            && getAfter(/databases/$(database)/documents/orders/$(requestId)).data.quantity == resource.data.requestedQuantity
            && getAfter(/databases/$(database)/documents/orders/$(requestId)).data.agreedPrice == resource.data.listedPrice)
        );

      allow delete: if false;
    }

    match /orders/{orderId} {
      allow get, list: if signedIn()
        && ((farmer() && resource.data.farmerId == request.auth.uid)
          || (supplier() && resource.data.supplierId == request.auth.uid));

      allow create: if farmer()
        && request.resource.data.orderId == orderId
        && request.resource.data.farmerId == request.auth.uid
        && request.resource.data.status == 'AWAITING_PICKUP'
        && coordinateLocation(request.resource.data.get('pickupLocation', ''))
        && coordinateLocation(request.resource.data.get('deliveryLocation', ''))
        && request.resource.data.pickupLocation == get(listingPath(request.resource.data.listingId)).data.location
        && (
          (request.resource.data.orderId == request.resource.data.bidId
            && exists(/databases/$(database)/documents/bids/$(request.resource.data.bidId))
            && get(/databases/$(database)/documents/bids/$(request.resource.data.bidId)).data.status == 'PENDING'
            && request.resource.data.deliveryLocation == get(/databases/$(database)/documents/bids/$(request.resource.data.bidId)).data.get('deliveryLocation', '')
            && get(/databases/$(database)/documents/bids/$(request.resource.data.bidId)).data.supplierId == request.resource.data.supplierId
            && get(/databases/$(database)/documents/bids/$(request.resource.data.bidId)).data.listingId == request.resource.data.listingId
            && exists(listingPath(request.resource.data.listingId))
            && get(listingPath(request.resource.data.listingId)).data.farmerId == request.auth.uid
            && get(listingPath(request.resource.data.listingId)).data.status == 'OPEN'
            && get(listingPath(request.resource.data.listingId)).data.biddingEnabled == true
            && publishedListing(get(listingPath(request.resource.data.listingId)).data)
        && coordinateLocation(get(listingPath(request.resource.data.listingId)).data.get('location', ''))
        && coordinateLocation(request.resource.data.get('deliveryLocation', ''))
            // The harvest must be READY (confirmed) before an order can be created from a bid.
            && get(listingPath(request.resource.data.listingId)).data.get('harvestStatus', 'READY') == 'READY'
            && request.resource.data.quantity == availableStock(get(listingPath(request.resource.data.listingId)).data)
            && request.resource.data.agreedPrice == get(/databases/$(database)/documents/bids/$(request.resource.data.bidId)).data.offerPrice
            && getAfter(/databases/$(database)/documents/bids/$(request.resource.data.bidId)).data.status == 'ACCEPTED'
            && getAfter(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.soldQuantity
              == get(listingPath(request.resource.data.listingId)).data.get('soldQuantity', 0)
                + request.resource.data.quantity
            && availableStock(getAfter(listingPath(request.resource.data.listingId)).data)
              == availableStock(get(listingPath(request.resource.data.listingId)).data)
                - request.resource.data.quantity
            && request.resource.data.quantity > 0)
          || (request.resource.data.bidId == ''
            && exists(/databases/$(database)/documents/order_requests/$(orderId))
            && get(/databases/$(database)/documents/order_requests/$(orderId)).data.status == 'PENDING'
            && request.resource.data.deliveryLocation == get(/databases/$(database)/documents/order_requests/$(orderId)).data.get('deliveryLocation', '')
            && get(/databases/$(database)/documents/order_requests/$(orderId)).data.requestId == orderId
            && get(/databases/$(database)/documents/order_requests/$(orderId)).data.farmerId == request.auth.uid
            && get(/databases/$(database)/documents/order_requests/$(orderId)).data.listingId == request.resource.data.listingId
            && get(/databases/$(database)/documents/order_requests/$(orderId)).data.supplierId == request.resource.data.supplierId
            && get(/databases/$(database)/documents/order_requests/$(orderId)).data.requestedQuantity == request.resource.data.quantity
            && get(/databases/$(database)/documents/order_requests/$(orderId)).data.listedPrice == request.resource.data.agreedPrice
            && exists(listingPath(request.resource.data.listingId))
            && get(listingPath(request.resource.data.listingId)).data.farmerId == request.auth.uid
            && get(listingPath(request.resource.data.listingId)).data.status == 'OPEN'
            && get(listingPath(request.resource.data.listingId)).data.biddingEnabled == false
            && publishedListing(get(listingPath(request.resource.data.listingId)).data)
        && coordinateLocation(get(listingPath(request.resource.data.listingId)).data.get('location', ''))
        && coordinateLocation(request.resource.data.get('deliveryLocation', ''))
            // The harvest must be READY (confirmed) before an order can be created from a request.
            && get(listingPath(request.resource.data.listingId)).data.get('harvestStatus', 'READY') == 'READY'
            && request.resource.data.quantity > 0
            && request.resource.data.quantity
              <= availableStock(get(listingPath(request.resource.data.listingId)).data)
            && getAfter(/databases/$(database)/documents/order_requests/$(orderId)).data.status == 'ACCEPTED'
            && getAfter(listingPath(request.resource.data.listingId)).data.soldQuantity
              == get(listingPath(request.resource.data.listingId)).data.get('soldQuantity', 0)
                + request.resource.data.quantity
            && availableStock(getAfter(listingPath(request.resource.data.listingId)).data)
              == availableStock(get(listingPath(request.resource.data.listingId)).data)
                - request.resource.data.quantity)
        );

      allow update: if signedIn()
        && ((farmer() && resource.data.farmerId == request.auth.uid)
          || (supplier() && resource.data.supplierId == request.auth.uid))
        && request.resource.data.orderId == resource.data.orderId
        && request.resource.data.bidId == resource.data.bidId
        && request.resource.data.listingId == resource.data.listingId
        && request.resource.data.farmerId == resource.data.farmerId
        && request.resource.data.supplierId == resource.data.supplierId
        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          || (supplier() && resource.data.supplierId == request.auth.uid
            && resource.data.status in ['AWAITING_PICKUP', 'IN_TRANSIT']
            && request.resource.data.status == resource.data.status
            && request.resource.data.deliveryLocation is string
            && coordinateLocation(request.resource.data.deliveryLocation)
            && request.resource.data.deliveryLocation.size() <= 2000
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deliveryLocation', 'updatedAt'])))
        && (
          request.resource.data.status == resource.data.status
          || (resource.data.status == 'AWAITING_PICKUP'
            && request.resource.data.status == 'IN_TRANSIT'
            && farmer()
            && resource.data.farmerId == request.auth.uid)
          || (resource.data.status == 'AWAITING_PICKUP'
            && request.resource.data.status == 'CANCELLED'
            && ((farmer() && resource.data.farmerId == request.auth.uid)
              || (supplier() && resource.data.supplierId == request.auth.uid)))
          || (resource.data.status == 'IN_TRANSIT'
            && request.resource.data.status == 'CANCELLED'
            && ((farmer() && resource.data.farmerId == request.auth.uid)
              || (supplier() && resource.data.supplierId == request.auth.uid)))
        );

      allow delete: if false;
    }

    match /order_completion_records/{recordId} {
      // Only the trusted completeOrder callable writes completion receipts and points.
      allow read, write: if false;
    }
    match /reviews/{reviewId} {
      allow get, list: if signedIn();

      allow create: if signedIn()
        && request.resource.data.reviewId == reviewId
        && reviewId == request.resource.data.orderId + '_' + request.resource.data.reviewerId
        && request.resource.data.reviewerId == request.auth.uid
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.matches('.*\\S.*')
        && exists(/databases/$(database)/documents/orders/$(request.resource.data.orderId))
        && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.status == 'DELIVERED'
        && (
          // Farmer reviewing supplier
          (farmer()
            && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.farmerId == request.auth.uid
            && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.supplierId == request.resource.data.revieweeId)
          // Supplier reviewing farmer
          || (supplier()
            && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.supplierId == request.auth.uid
            && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.farmerId == request.resource.data.revieweeId)
        )
        // Ensure reviewer hasn't already reviewed this order
        && !exists(/databases/$(database)/documents/reviews/$(reviewId));

      allow update: if false;
      allow delete: if false;
    }
  }
}
