<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Main App Theme -->
    <style name="Theme.AgroRoute" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="android:windowBackground">@color/startup_background</item>
    </style>

    <!-- 🌟 Splash Screen Theme 🌟 -->
    <style name="Theme.AgroRoute.Splash.Base" parent="Theme.SplashScreen">
        <!-- Background පාට -->
        <item name="windowSplashScreenBackground">@color/startup_background</item>
        <item name="android:statusBarColor">@color/startup_background</item>
        <item name="android:navigationBarColor">@color/startup_background</item>
        <item name="android:windowLightStatusBar">@bool/startup_light_system_bars</item>

        <!-- අපි හදපු PNG Logo එක -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>

        <!-- Splash ඉවර උනාම එන Theme එක -->
        <item name="postSplashScreenTheme">@style/Theme.AgroRoute</item>
    </style>

    <style name="Theme.AgroRoute.Splash" parent="Theme.AgroRoute.Splash.Base" />

</resources>
